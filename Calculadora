    def _iniciar_scroll(self): # Método para posicionar corretamente o Canvas e os widgets ao iniciar a Calculadora
        if self._canvas.winfo_width() <= 1: # Canvas ainda não criado
            self._janela.after(10, self._iniciar_scroll) # Tenta novamente em 10ms
        else:
            self._ajustar_scroll()

    def _ajustar_scroll(self):
        self._janela.update_idletasks() # Força o processamento imediato das tarefas pendentes de atualização da interface gráfica que estão na fila de eventos
        self._ajustar_espacador_topo()
        self._canvas.configure(scrollregion=self._canvas.bbox('all')) # Atualiza a área rolável como o tamanho total dos elementos no canvas
        self._canvas.yview_moveto(1.0) # Em toda atualização, mantém o scroll no limite inferior
        self._canvas.itemconfigure('frame_painel_window', width=self._canvas.winfo_width()) # Força a largura do conteúdo view._frame_painel a se adaptar dinamicamente à largura atual do Canvas
    
    def _ajustar_espacador_topo(self):
        altura_espacador = max(0, self._canvas.winfo_height() - self._frame_painel.winfo_reqheight()) # Define a altura do espaçador como o máximo entre 0 e a diferença da altura visível do Canvas e a altura total requisitada pelo painel interno
        if altura_espacador <= 0: # Se o conteúdo for maior ou igual à tela visível...
            if self._espacador_topo.winfo_ismapped():
                self._espacador_topo.pack_forget() # ...remove o widget do Frame
        else:
            if not self._espacador_topo.winfo_ismapped(): # Se há espaço sobrando e o espaçador ainda não está exibido...
                self._espacador_topo.pack(fill=X, before=self._painel_historico) # ...posiciona o widget no Frame acima do widget do histórico
            self._espacador_topo.configure(height=altura_espacador) # Ajusta a altura do espaçador para empurrar o conteúdo visível para baixo

    def _ativar_scroll(self):
        def _ao_rolar(evento): # Handler de resposta aos eventos de scroll do mouse; o parâmetro evento é um objeto passado automaticamente pelo Tkinter, com informações fornecidas pelo sistema operacional (atributos que descrevem o evento): evento.delta (atributo para o valor do scroll no Windows/MacOS) e evento.num (atributo para o número do botão no Linux)
            delta = 0 # Valor inicial neutro
            if evento.num == 4:
                delta = -1
            elif evento.num == 5:
                delta = 1
            elif evento.delta:
                delta = -1 * (evento.delta // 120) # evento.delta é múltiplo de 120 (representa os dentes do scroll do mouse, valores positivos rolam para cima e valores negativos rolam para baixo), então a expressão resulta na unidade rolada, com sinal invertido para seguir a convenção do Tkinter (scroll positivo rola para baixo e scroll negativo rola para cima)
            if delta != 0:
                self._canvas.yview_scroll(delta, 'units') # Rola o conteúdo verticalmente com os parâmetros: (unidades a rolar, tipo de rolagem)

        self._canvas.bind_all('<MouseWheel>', _ao_rolar) # Windows/MacOS scroll
        self._canvas.bind_all('<Button-4>', _ao_rolar) # Linux scroll up
        self._canvas.bind_all('<Button-5>', _ao_rolar) # Linux scroll down

    def _ativar_teclado(self):
        def _ao_digitar(evento): # Handler de resposta aos eventos de tecla
            if evento.keysym in ('Up', 'Down', 'Prior', 'Next', 'End'): # Caso para rolar com setas, Page Up/Down ou End
                if evento.keysym == 'Up': # Tecla ↑
                    self._canvas.yview_scroll(-1, 'units')
                elif evento.keysym == 'Down': # Tecla ↓
                    self._canvas.yview_scroll(1, 'units')
                elif evento.keysym == 'Prior':  # Tecla Page Up
                    self._canvas.yview_scroll(-1, 'pages')
                elif evento.keysym == 'Next':  # Tecla Page Down
                    self._canvas.yview_scroll(1, 'pages')
                elif evento.keysym == 'End':
                    self._canvas.yview_moveto(1.0)
            # Continua as verificações do atributo keysym antes de verificar char
            if evento.keysym == 'Delete':
                self.controller.limpar()
            elif evento.keysym == 'BackSpace':
                self.controller.apagar()
            elif evento.keysym == 'Return' or evento.char == '=': # Tecla Enter ou =
                self.controller.igual()
            # Verificações do atributo char
            elif evento.char: # Garante que char não é uma string vazia ('')
                if evento.char in '0123456789':
                    self.controller.adicionar_numero(evento.char)
                elif evento.char in '.,':
                    self.controller.adicionar_virgula()
                elif evento.char in '+-*x/:':
                    self.controller.adicionar_operador(evento.char)
                elif evento.char == '%':
                    self.controller.porcentagem()
                elif evento.char == 'X':
                    self.controller.xuxu()

        self._janela.bind('<KeyPress>', _ao_digitar) # Os valores evento.keysym e evento.char funcionam de forma consistente no Tkinter em Windows, macOS e Linux

    def atualizar_historico(self, historico):
        historico_formatado = []
        for expressao, resultado in historico:
            expressao_formatada = self._inserir_separadores(expressao)
            expressao_quebrada, _ = self._quebrar_em_linhas(expressao_formatada)
            resultado_formatado = ''.join(self._inserir_separadores([resultado]))
            historico_formatado.append(f'{expressao_quebrada}\n= {resultado_formatado}')
        exibicao_historico = '\n'.join(historico_formatado)
        self._painel_historico.config(text=exibicao_historico)
        self._ajustar_scroll()

    def atualizar_expressao(self, expressao, view_mostrar_igual=False, view_aproximado=False):
        expressao_formatada = self._inserir_separadores(expressao)
        expressao_quebrada, maior_linha = self._quebrar_em_linhas(expressao_formatada)
        if view_mostrar_igual and not expressao_quebrada.startswith('ERRO'):
            if view_aproximado:
                expressao_quebrada = f'≈ {expressao_quebrada}'
            else:
                expressao_quebrada = f'= {expressao_quebrada}'
        self._atualizar_tamanho(maior_linha)
        self._atualizar_cor(expressao_quebrada)
        self._painel_expressao.config(text=expressao_quebrada)
        self._ajustar_scroll()
        self._tecla_limpar.config(text='AC' if expressao == ['0'] else 'C')

    def atualizar_resultado_parcial(self, resultado_parcial):
        if resultado_parcial is not None:
            resultado_parcial_formatado = '= ' + ''.join(self._inserir_separadores([format(resultado_parcial.normalize(), 'f')]))
            self._painel_resultado_parcial.config(text=resultado_parcial_formatado)
            if not self._painel_resultado_parcial.winfo_ismapped(): # Se o resultado parcial não estiver sendo exibido...
                self._painel_resultado_parcial.pack(fill=X, pady=(0, 10), padx=10) # ...posiciona o widget no Frame
        else:
            if self._painel_resultado_parcial.winfo_ismapped(): # Se o resultado parcial for None e estiver sendo exibido...
                self._painel_resultado_parcial.pack_forget() # ...remove o widget do Frame
        self._ajustar_scroll()

    def _inserir_separadores(self, valor):
        if valor[0].startswith('ERRO') or valor[0].startswith('💖'):
            return valor[0]
        resultado_formatado = []
        for token in valor:
            if token in '+-x÷':
                resultado_formatado.append(token)
                continue
            token_virgula = token.replace('.', ',')
            if ',' in token_virgula:
                parte_inteira, parte_decimal = token_virgula.split(',')
            else:
                parte_inteira, parte_decimal = token_virgula, ''
            parte_inteira_limpa = parte_inteira.replace('.', '')
            parte_inteira_formatada = '{:,}'.format(int(parte_inteira_limpa)).replace(',', '.') # {} marcador de substituição
            numero_formatado = parte_inteira_formatada + (',' + parte_decimal if ',' in token_virgula else '')
            resultado_formatado.append(numero_formatado)
        return resultado_formatado
    
    def _quebrar_em_linhas(self, expressao): # Recebe uma lista de tokens e retorna a expressão quebrada em linhas
        linhas = []
        linha_atual = '' # String vazia que acumula os tokens até atingir o limite máximo
        maior_linha = 0 # Variável para armazenar a quantidade de caracteres da maior linha, usada para ajustar o tamanho da fonte da expressão
        for token in expressao:
            if len(linha_atual) + len(token) > self.MAXIMO_CARACTERES_LINHA: # Se a junção do novo token ultrapassar o limite...
                linhas.append(linha_atual) # ...salva a linha sem o token atual,
                maior_linha = max(maior_linha, len(linha_atual)) # ...atualiza qual é a maior linha
                linha_atual = '' # ...e reinicia a linha atual
            linha_atual += token
        if linha_atual: # Depois de percorrer todos os tokens, se ainda restou conteúdo em linha_atual...
            linhas.append(linha_atual) # ...adiciona essa última linha à lista
            maior_linha = max(maior_linha, len(linha_atual))
        return '\n'.join(linhas), maior_linha # Retorna a expressão como uma string com quebras de linha e o comprimento da maior linha
    
    def _atualizar_tamanho(self, maior_linha):
        if maior_linha < 13:
            tamanho_fonte = 32
        elif maior_linha >= 20:
            tamanho_fonte = 20
        else:
            tamanho_fonte = 32 - 2 * (maior_linha - 13)
        self._painel_expressao.config(font=('Arial', tamanho_fonte, 'bold'))
    
    def _atualizar_cor(self, valor):
        if valor.startswith('ERRO'):
            self._painel_expressao.config(fg=cor_erro)
        elif valor.startswith('💖'):
            self._painel_expressao.config(fg=cor_xuxu)
        else:
            self._painel_expressao.config(fg=cor_expressao)

    def iniciar_loop(self):
        self._janela.mainloop()

# Controlador: recebe ações de View e atualiza Model e View
class CalculadoraController:
    def __init__(self, model, view):
        self._model = model
        self.view = view
    
    def _atualizar_historico(self):
        self.view.atualizar_historico(self._model.historico)

    def _atualizar_expressao(self, controller_mostrar_igual=False, controller_aproximado=False):
        self.view.atualizar_expressao(self._model.expressao, view_mostrar_igual=controller_mostrar_igual, view_aproximado=controller_aproximado)
    
    def _atualizar_resultado_parcial(self):
        self.view.atualizar_resultado_parcial(self._model.resultado_parcial)

    def adicionar_numero(self, n):
        self._model.adicionar_numero(n)
        self._atualizar_expressao()
        self._atualizar_resultado_parcial()
    
    def adicionar_virgula(self):
        self._model.adicionar_virgula()
        self._atualizar_expressao()

    def adicionar_operador(self, operador):
        if operador == '*':
            self._model.adicionar_operador('x')
        elif operador in '/:':
            self._model.adicionar_operador('÷')
        else:
            self._model.adicionar_operador(operador)
        self._atualizar_expressao()
    
    def porcentagem(self):
        self._model.porcentagem()
        self._atualizar_expressao()
        self._atualizar_resultado_parcial()
    
    def igual(self):
        aproximado = self._model.igual() # Chama o método igual e captura o valor booleano de retorno que indica se o resultado foi aproximado (True) ou não (False)
        self._atualizar_expressao(controller_mostrar_igual=True, controller_aproximado=aproximado)
        self._atualizar_historico()
        self._atualizar_resultado_parcial()
    
    def limpar(self):
        self._model.limpar()
        self._atualizar_expressao()
        self._atualizar_historico()
        self._atualizar_resultado_parcial()

    def apagar(self):
        self._model.apagar()
        self._atualizar_expressao()
        self._atualizar_resultado_parcial()
    
    def xuxu(self):
        self._model.xuxu()
        self._atualizar_expressao()
        self._atualizar_historico()
        self._atualizar_resultado_parcial()

# Função para criar as instâncias, conectá-las e iniciar o loop principal da interface gráfica
def iniciar_calculadora():
    modelo = CalculadoraModel()
    controlador = CalculadoraController(modelo, None)
    visao = CalculadoraView(controlador)
    controlador.view = visao
    visao.iniciar_loop()

iniciar_calculadora()