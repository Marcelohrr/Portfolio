# Modelo: lógica interna
class CalculadoraModel:
    MAXIMO_CARACTERES_NUMERO = 15
    MAXIMO_CARACTERES_DECIMAL = 20

    def __init__(self):
        self._historico = [] # Lista de tuplas [([expressão], resultado)]
        self._expressao = ['0'] # Lista de strings, separando números e operadores
        self._resultado_parcial = None # Decimal como resultado intermediário

    @property
    def expressao(self):
        return self._expressao
    
    @expressao.setter
    def expressao(self, valor):
        self._expressao = valor
    
    @property
    def resultado_parcial(self):
        return self._resultado_parcial

    @resultado_parcial.setter
    def resultado_parcial(self, valor):
        self._resultado_parcial = valor
    
    @property
    def historico(self):
        return self._historico
    
    @historico.setter
    def historico(self, valor):
        self._historico = valor

    def _calculo_parcial(self):
        if self.expressao[0].startswith('ERRO') or self.expressao[0].startswith('💖'):
            self.resultado_parcial = None
            return
        expressao_convertida = ''.join(self.expressao).replace('x', '*').replace('÷', '/').replace(',', '.')
        if self.expressao[-1] in '+-x÷':
            expressao_convertida = expressao_convertida[:-1]
        try:
            resultado = Decimal(eval(expressao_convertida))
            resultado_str = self._limitar_resultado(resultado)
            self.resultado_parcial = Decimal(resultado_str)
        except Exception:
            self.resultado_parcial = None
    
    def _limitar_resultado(self, valor_decimal):
        valor_str = format(valor_decimal.normalize(), 'f') # resultado_str = format(resultado.normalize(), 'f')
        if '.' in valor_str:
            parte_inteira, parte_decimal = valor_str.split('.')
            if len(parte_inteira) > self.MAXIMO_CARACTERES_NUMERO:
                raise ValueError()
            sobra_decimal = self.MAXIMO_CARACTERES_DECIMAL - len(parte_inteira) # Espaço restante para a parte decimal
            if len(parte_decimal) > sobra_decimal: # Se a parte decimal ultrapassar o limite...
                precisao = '1.' + '0' * sobra_decimal # ...concatena '1.' ao número de zeros depois da vírgula necessários para definir o valor fixo de precisão necessário para o método quantize(),
                valor_aproximado = valor_decimal.quantize(Decimal(precisao)) #...aproxima o valor original
                return str(valor_aproximado), True # ...e retorna a string do valor aproximado (incado por True)
            else:
                return valor_str, False
        else:
            if len(valor_str) > self.MAXIMO_CARACTERES_NUMERO:
                raise ValueError()
            return valor_str, False

    def _adicionar_ao_historico(self, expressao_resultado):
        self._historico.append(expressao_resultado)

    # Teclas dos números
    def adicionar_numero(self, n):
        if self.expressao == ['0'] or self.expressao[0].startswith('ERRO') or self.expressao[0].startswith('💖'):
            self.expressao = [n]
        else:
            ultimo_numero = self.expressao[-1]
            limite = self.MAXIMO_CARACTERES_DECIMAL if ',' in ultimo_numero else self.MAXIMO_CARACTERES_NUMERO
            if len(ultimo_numero) >= limite:
                return
            elif ultimo_numero not in '+-x÷':
                self.expressao[-1] += n
            else:
                self.expressao.append(n)
        self._calculo_parcial()

    # Tecla da vírgula
    def adicionar_virgula(self):
        if self.expressao[0].startswith('ERRO') or self.expressao[0].startswith('💖'):
            self.expressao = ['0,']
        elif self.expressao[-1] not in '+-x÷':
            if ',' not in self.expressao[-1]:
                self.expressao[-1] += ','
        else:
            self.expressao.append('0,')

    # Teclas dos operadores
    def adicionar_operador(self, operador):
        if self.expressao[0].startswith('ERRO') or self.expressao == ['-'] or self.expressao[0].startswith('💖'):
            self.expressao = ['0', operador]
        elif operador == '-' and self.expressao == ['0']:
            self.expressao = ['-']
        elif self.expressao[-1] in '+-x÷':
            self.expressao[-1] = operador
        elif not self.expressao[-1].endswith(','):
            self.expressao.append(operador)
    
    # Teclas das operações
    def porcentagem(self):
        if self.expressao[0].startswith('ERRO') or self.expressao[0].startswith('💖'):
            self.expressao = ['0']
            return
        elif self.expressao[-1] in '+-x÷,':
            return
        token = self.expressao[-1]
        token_convertido = token.replace(',', '.')
        resultado = Decimal(token_convertido) * Decimal('0.01')
        resultado_str, _ = self._limitar_resultado(resultado)
        self.expressao[-1] = resultado_str
        self._calculo_parcial()
    
    def igual(self):
        aproximado = False
        if self.expressao[0].startswith('ERRO') or self.expressao[0].startswith('💖'):
            self.expressao = ['0']
            self.resultado_parcial = None
            return
        elif self.expressao[-1] in '+-x÷,':
            self.expressao.pop()
        expressao_str = ''.join(self.expressao)
        if self.resultado_parcial is not None:
            try:
                resultado_str, aproximado = self._limitar_resultado(self.resultado_parcial) # ValueError levantado ao ultrapassar limite de caracteres
            except ValueError:
                self.expressao = ['ERRO: Limite excedido']
            else:
                self._adicionar_ao_historico((self.expressao.copy(), resultado_str))
                if resultado_str.startswith('-'):
                    self.expressao = ['-', resultado_str[1:]]
                else:
                    self.expressao = [resultado_str]
            self.resultado_parcial = None
        else:
            expressao_convertida = expressao_str.replace('x', '*').replace('÷', '/').replace(',', '.')
            try:
                resultado = Decimal(eval(expressao_convertida))
                resultado_str, aproximado = self._limitar_resultado(resultado) # ValueError levantado ao ultrapassar limite de caracteres
            except ZeroDivisionError:
                self.expressao = ['ERRO: Divisão por 0']
            except ValueError:
                self.expressao = ['ERRO: Limite excedido']
            except:
                self.expressao = ['0']
            else:
                self._adicionar_ao_historico((self.expressao.copy(), resultado_str))
                if resultado_str.startswith('-'):
                    self.expressao = ['-', resultado_str[1:]]
                else:
                    self.expressao = [resultado_str]
            self.resultado_parcial = None
        return aproximado

    # Teclas de apagar
    def limpar(self):
        if self.expressao != ['0']:
            self.expressao = ['0']
        else:
            self.historico.clear()
        self.resultado_parcial = None
    
    def apagar(self):
        if self.expressao[0].startswith('ERRO') or self.expressao[0].startswith('💖'):
            self.expressao = ['0']
            self.resultado_parcial = None
        elif len(self.expressao[-1]) > 1:
            self.expressao[-1] = self.expressao[-1][:-1]
            self._calculo_parcial()
        elif len(self.expressao) > 1:
            self.expressao.pop()
            self._calculo_parcial()
        else:
            self.expressao = ['0']
            self.resultado_parcial = None

    def xuxu(self):
        self.expressao = ['💖 XUXU, EU TE AMO! 💖']
        self._historico = []
        self.resultado_parcial = None

