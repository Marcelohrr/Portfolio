# Lógica interna
class Calculadora:
    def __init__(self, painel):
        self._painel = painel
    
    @property
    def expressao(self):
        return self._painel.cget('text')
    
    @expressao.setter
    def expressao(self, valor):
        self._painel.config(text=valor)
        self._atualizar_cor(valor)

    def _atualizar_cor(self, valor): # Método auxiliar do setter
        if valor == 'ERRO:\nDivisão por 0':
            self._painel.config(fg=cor_erro)
        else:
            self._painel.config(fg=cor_painel)

    # Teclas dos números
    def numero(self, n):
        if self.expressao == '0':
            self.expressao = n
        else:
            self.expressao += n
    
    # Tecla da vírgula
    def virgula(self):
        if not self.expressao[-1].isdigit():
            return
        for caractere in reversed(self.expressao):
            if caractere == ',':
                return
            elif caractere in ('+', '-', 'x', '÷'):
                break
        self.expressao += ','
    
    # Teclas das operações
    def adicionar_operador(self, operador):
        if self.expressao[-1] not in ('+', '-', 'x', '÷', ','):
            self.expressao += operador
    def porcentagem(self):
        numero = []
        if self.expressao[-1] in ('+', '-', 'x', '÷', ','):
            return
        for caractere in reversed(self.expressao):
            if caractere.isdigit():
                numero.insert(0, caractere)
            elif caractere == ',':
                numero.insert(0, '.')
            elif caractere in ('+', '-', 'x', '÷'):
                break
        if not numero:
            return
        resultado = Decimal(''.join(numero)) * Decimal('0.01')
        resultado = format(resultado.normalize(), 'f')
        resultado = resultado.replace('.', ',')
        nova_expressao = self.expressao[:-len(numero)] + resultado
        self.expressao = nova_expressao
    def igual(self):
        if self.expressao[-1] in ('+', '-', 'x', '÷', ','):
            self.expressao = self.expressao[:-1]
        expressao_convertida = self.expressao.replace('x', '*').replace('÷', '/').replace(',', '.')
        try:
            resultado = Decimal(eval(expressao_convertida))
            resultado = format(resultado.normalize(), 'f')
            if '.' in resultado:
                resultado = resultado.replace('.', ',')
            self.expressao = resultado
        except ZeroDivisionError:
            self.expressao = 'ERRO:\nDivisão por 0'

    # Teclas de apagar
    def limpar(self):
        self.expressao = '0'
    def apagar(self):
        if len(self.expressao) > 1:
            self.expressao = self.expressao[:-1]
        else:
            self.expressao = '0'

