# Lógica interna
class Calculadora:
    def __init__(self, painel):
        self._painel = painel

    # Teclas dos números
    def zero(self):
        if self._painel['text'] != '0':
            self._painel['text'] += '0'
    def um(self):
        if self._painel['text'] == '0':
            self._painel['text'] = '1'
        else:
            self._painel['text'] += '1'
    def dois(self):
        if self._painel['text'] == '0':
            self._painel['text'] = '2'
        else:
            self._painel['text'] += '2'
    def tres(self):
        if self._painel['text'] == '0':
            self._painel['text'] = '3'
        else:
            self._painel['text'] += '3'
    def quatro(self):
        if self._painel['text'] == '0':
            self._painel['text'] = '4'
        else:
            self._painel['text'] += '4'
    def cinco(self):
        if self._painel['text'] == '0':
            self._painel['text'] = '5'
        else:
            self._painel['text'] += '5'
    def seis(self):
        if self._painel['text'] == '0':
            self._painel['text'] = '6'
        else:
            self._painel['text'] += '6'
    def sete(self):
        if self._painel['text'] == '0':
            self._painel['text'] = '7'
        else:
            self._painel['text'] += '7'
    def oito(self):
        if self._painel['text'] == '0':
            self._painel['text'] = '8'
        else:
            self._painel['text'] += '8'
    def nove(self):
        if self._painel['text'] == '0':
            self._painel['text'] = '9'
        else:
            self._painel['text'] += '9'
    
    # Tecla da vírgula
    def virgula(self):
        if not self._painel['text'][-1].isdigit():
            return
        for caractere in reversed(self._painel['text']):
            if caractere == ',':
                return
            elif caractere in ('+', '-', 'x', '÷'):
                break
        self._painel['text'] += ','
    
    # Teclas das operações
    def adicao(self):
        if self._painel['text'][-1] not in ('+', '-', 'x', '÷', ','):
            self._painel['text'] += '+'
    def subtracao(self):
        if self._painel['text'][-1] not in ('+', '-', 'x', '÷', ','):
            self._painel['text'] += '-'
    def multiplicacao(self):
        if self._painel['text'][-1] not in ('+', '-', 'x', '÷', ','):
            self._painel['text'] += 'x'
    def divisao(self):
        if self._painel['text'][-1] not in ('+', '-', 'x', '÷', ','):
            self._painel['text'] += '÷'
    def porcentagem(self):
        expressao = self._painel.cget('text')
        numero = []
        if expressao[-1] in ('+', '-', 'x', '÷', ','):
            return
        for caractere in reversed(expressao):
            if caractere.isdigit():
                numero.insert(0, caractere)
            elif caractere == ',':
                numero.insert(0, '.')
            elif caractere in ('+', '-', 'x', '÷'):
                break
        if not numero:
            return
        resultado = Decimal(''.join(numero)) * Decimal('0.01')
        resultado = format(resultado.normalize(), 'f')
        resultado = resultado.replace('.', ',')
        expressao = expressao[:-len(numero)] + resultado
        self._painel.config(text=expressao)
    def igual(self):
        expressao = self._painel.cget('text')
        if expressao[-1] in ('+', '-', 'x', '÷', ','):
            expressao = expressao[:-1]
        expressao = expressao.replace('x', '*').replace('÷', '/').replace(',', '.')
        try:
            resultado = Decimal(eval(expressao))
            resultado = format(resultado.normalize(), 'f')
            if '.' in resultado:
                resultado = resultado.replace('.', ',')
            self._painel.config(text=resultado)
        except ZeroDivisionError:
            self._painel.config(text='ERRO:\nDivisão por 0', fg=cor_erro)

    # Teclas de apagar
    def limpar(self):
        self._painel['text'] = '0'
    def apagar(self):
        if len(self._painel['text']) > 1:
            self._painel['text'] = self._painel['text'][:-1]
        elif len(self._painel['text']) == 1:
            self._painel['text'] = '0'

