# Lógica interna
class Calculadora:
    def __init__(self, painel):
        self._painel = painel
    
    @property
    def expressao(self):
        return self._painel.cget('text')
    
    @expressao.setter
    def expressao(self, valor):
        exibicao_separadores = self._inserir_separadores(valor)
        self._painel.config(text=exibicao_separadores)
        self._atualizar_cor(valor)
        self._atualizar_tamanho(valor)
    
    # Métodos auxiliares do setter
    def _inserir_separadores(self, valor):
        if valor[:4] == 'ERRO':
            return valor
        partes_expressao = re.split(r'([+\-x÷])', valor) # r'' para não escapar \, para escapar - (igual a \\-), () para incluir operadores no resultado e [] para identificar cada operador separadamente
        ultimo_numero = partes_expressao[-1]
        if ultimo_numero != '': # Se o último valor no painel for um operador, ultimo_numero será ''
            if ',' in ultimo_numero:
                parte_inteira, parte_decimal = ultimo_numero.split(',')
            else:
                parte_inteira, parte_decimal = ultimo_numero, ''
            parte_inteira = parte_inteira.replace('.', '')
            parte_inteira = '{:,}'.format(int(parte_inteira)).replace(',', '.') # {} marcador de substituição
            numero_formatado = parte_inteira + (',' + parte_decimal if ',' in ultimo_numero else '')
            return ''.join(partes_expressao[:-1]) + numero_formatado
        else:
            return valor

    def _atualizar_cor(self, valor):
        if valor[:4] == 'ERRO':
            self._painel.config(fg=cor_erro)
        else:
            self._painel.config(fg=cor_painel)
    
    def _atualizar_tamanho(self, valor):
        tamanho = len(valor)
        if tamanho < 15:
            tamanho_fonte = 32
        elif tamanho >= 20:
            tamanho_fonte = 20
        else:
            tamanho_fonte = 32 - 2 * (tamanho - 15)
        self._painel.config(font=('Arial', tamanho_fonte, 'bold'))

    # Teclas dos números
    def numero(self, n):
        if self.expressao == '0' or self.expressao[:4] == 'ERRO':
            self.expressao = n
        else:
            self.expressao += n

    # Tecla da vírgula
    def virgula(self):
        if self.expressao[:4] == 'ERRO':
            self.expressao = '0,'
        else:
            ultimo_numero = re.split(r'([+\-x÷])', self.expressao)[-1]
            if ',' not in ultimo_numero and ultimo_numero != '':
                self.expressao += ','

    # Teclas das operações
    def adicionar_operador(self, operador):
        if self.expressao[:4] == 'ERRO':
            self.expressao = '0' + operador
        elif self.expressao[-1] in ('+', '-', 'x', '÷'):
            self.expressao = self.expressao[:-1] + operador
        elif self.expressao[-1] != ',':
            self.expressao += operador
    def porcentagem(self):
        numero = []
        if self.expressao[:4] == 'ERRO':
            self.expressao = '0,00'
        elif self.expressao[-1] in ('+', '-', 'x', '÷', ','):
            return
        for caractere in reversed(self.expressao):
            if caractere.isdigit():
                numero.insert(0, caractere)
            elif caractere == ',':
                numero.insert(0, '.')
            elif caractere in ('+', '-', 'x', '÷'):
                break
        if not numero:
            return
        resultado = Decimal(''.join(numero)) * Decimal('0.01')
        resultado = format(resultado.normalize(), ',').replace(',', '#').replace('.', ',').replace('#', '.')
        nova_expressao = self.expressao[:-len(numero)] + resultado
        self.expressao = nova_expressao
    def igual(self):
        if self.expressao[:4] == 'ERRO':
            self.expressao = '0'
        elif self.expressao[-1] in ('+', '-', 'x', '÷', ','):
            self.expressao = self.expressao[:-1]
        expressao_convertida = self.expressao.replace('x', '*').replace('÷', '/').replace(',', '.')
        try:
            resultado = Decimal(eval(expressao_convertida))
            resultado = format(resultado.normalize(), 'f')
            if '.' in resultado:
                resultado = resultado.replace('.', ',')
            self.expressao = resultado
        except ZeroDivisionError:
            self.expressao = 'ERRO:\nDivisão por 0'

    # Teclas de apagar
    def limpar(self):
        self.expressao = '0'
    def apagar(self):
        if self.expressao[:4] == 'ERRO':
            self.expressao = '0'
        elif len(self.expressao) > 1:
            self.expressao = self.expressao[:-1]
        else:
            self.expressao = '0'

